[Unit]
Description=Back up RunBuoy PostgreSQL and secrets
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/runbuoy/backup.env
ExecStart=/usr/local/sbin/backup-runbuoy
SyslogIdentifier=runbuoy-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
