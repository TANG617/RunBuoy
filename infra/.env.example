# PostgreSQL
RUNBUOY_REGION=global
RUNBUOY_ENV_FILE=.env.example
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=120
POSTGRES_DB=runbuoy
POSTGRES_USER=runbuoy
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://runbuoy:replace-with-a-long-random-password@db:5432/runbuoy

# Generate both values independently. TOKEN_ENCRYPTION_KEY must be a Fernet key.
CREDENTIAL_PEPPER=replace-with-at-least-32-random-bytes
# Syntactically valid synthetic development key; replace in every deployment.
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# mock is safe for development/CI. production performs real APNs HTTP/2 requests.
APNS_MODE=mock
APNS_ENVIRONMENT=development
APNS_BUNDLE_ID=dev.runbuoy.app
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=/run/secrets/apns_key.p8

PAIRING_TTL_SECONDS=300
EVENT_RETENTION_HOURS=24
LIVE_ACTIVITY_START_DELAY_SECONDS=5
LIVE_ACTIVITY_UPDATE_INTERVAL_SECONDS=1
LIVE_ACTIVITY_MAX_PER_DEVICE=2
LIVE_ACTIVITY_PENDING_TTL_SECONDS=300
OUTBOX_MAX_ATTEMPTS=6
