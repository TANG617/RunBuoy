# PostgreSQL
RUNBUOY_REGION=global
RUNBUOY_ENV_FILE=.env.example
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=120
POSTGRES_DB=runbuoy
POSTGRES_USER=runbuoy
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://runbuoy:replace-with-a-long-random-password@db:5432/runbuoy

# Generate both values independently. TOKEN_ENCRYPTION_KEY must be a Fernet key.
CREDENTIAL_PEPPER=replace-with-at-least-32-random-bytes
# Syntactically valid synthetic development key; replace in every deployment.
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# mock is safe for development/CI. production performs real APNs HTTP/2 requests.
APNS_MODE=mock
APNS_ENVIRONMENT=development
APNS_BUNDLE_ID=dev.runbuoy.app
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=/run/secrets/apns_key.p8

PAIRING_TTL_SECONDS=300
EVENT_RETENTION_HOURS=24
RUN_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=30
PUSH_ATTEMPT_RETENTION_DAYS=7
OUTBOX_TERMINAL_RETENTION_DAYS=7
PAIRING_RETENTION_HOURS=24
AUDIT_RETENTION_DAYS=90
SAFE_LOG_TAIL_RETENTION_HOURS=24
RETENTION_CLEANUP_BATCH_SIZE=500
WORKSPACE_DELETION_CHALLENGE_TTL_SECONDS=300
LIVE_ACTIVITY_START_DELAY_SECONDS=5
LIVE_ACTIVITY_UPDATE_INTERVAL_SECONDS=1
LIVE_ACTIVITY_MAX_PER_DEVICE=2
LIVE_ACTIVITY_PENDING_TTL_SECONDS=300
OUTBOX_MAX_ATTEMPTS=6

# Application-layer abuse controls. RATE_LIMIT_IP_PEPPER should be generated
# independently from CREDENTIAL_PEPPER. Leave TRUSTED_PROXY_CIDRS empty unless
# every listed proxy appends/sanitizes X-Forwarded-For.
MAX_REQUEST_BODY_BYTES=262144
RATE_LIMIT_IP_PEPPER=replace-with-an-independent-32-byte-random-value
TRUSTED_PROXY_CIDRS=
# Secure default: return 503 when persistent limiter accounting is unavailable.
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_BUCKET_RETENTION_SECONDS=3600
RATE_LIMIT_DEVICE_BOOTSTRAP_PER_HOUR=20
RATE_LIMIT_PAIRING_CREATE_PER_HOUR=30
RATE_LIMIT_PAIRING_POLL_PER_MINUTE=120
RATE_LIMIT_RUN_UPSERT_PER_MINUTE=120
RATE_LIMIT_EVENT_BATCH_PER_MINUTE=240
RATE_LIMIT_NOTIFICATION_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_EVENT_PER_MINUTE=240

MAX_MACHINES_PER_WORKSPACE=25
MAX_ACTIVE_RUNS_PER_MACHINE=100
MAX_PENDING_PAIRINGS_PER_IP=10
MAX_WEBHOOKS_PER_WORKSPACE=50
MAX_NOTIFICATIONS_PER_WORKSPACE_DAY=1000
MAX_EVENTS_PER_BATCH=100
